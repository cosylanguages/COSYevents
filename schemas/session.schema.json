{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session",
  "type": "object",
  "required": [
    "slug",
    "event",
    "title",
    "theme",
    "language",
    "level",
    "date",
    "host",
    "summary",
    "activities",
    "vocabulary"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "date": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "instructions", "content"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "translation", "example", "level"],
        "additionalProperties": false,
        "properties": {
          "word": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
          }
        }
      }
    }
  }
}
