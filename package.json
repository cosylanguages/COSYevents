{
  "name": "cosyevents",
  "version": "1.0.0",
  "description": "COSYevents Calendar & Event Hub for the COSYlanguages ecosystem",
  "main": "index.html",
  "scripts": {
    "validate": "node scripts/validate-events.js",
    "build-public": "node scripts/build-public.js",
    "publish": "node scripts/publish-events.js",
    "test": "node scripts/test-no-leak.js && node scripts/test_studio.js && node scripts/test_session_publish.js && node scripts/test_session_directory.js && node scripts/test_daily_spotlights.js",
    "test-daily-spotlights": "node scripts/test_daily_spotlights.js",
    "fetch-daily-spotlights": "node scripts/fetch_daily_spotlights.js",
    "check-structure": "node scripts/check_page_structure.js",
    "check-links": "node scripts/check_links.js",
    "check:gated": "node scripts/check-gated-pages.js",
    "session:new": "node scripts/session_new.js",
    "session:publish": "node scripts/session_publish.js",
    "build-i18n": "node scripts/build_localized_manifest.js",
    "check-i18n": "node scripts/build_localized_manifest.js --check",
    "test-lang": "node scripts/test_lang.js",
    "test-calendar-i18n": "node scripts/test_calendar_i18n.js",
    "test-event-filter": "node scripts/test_event_filter.js",
    "test-auth": "node scripts/test_auth.js",
    "test-sso-cms": "node scripts/test_sso_cms.js",
    "test-studio": "node scripts/test_studio.js",
    "test-db": "bash scripts/run_db_tests.sh",
    "export-vocab": "node scripts/export-vocab.js",
    "test-vocab-export": "node scripts/test_vocab_export.js",
    "test:private-export": "node scripts/test_private_export.js",
    "test:video-meetings": "bash scripts/test_video_meetings_schema.sh",
    "test:hubs": "node scripts/test_hubs_visual.js",
    "export:private-sessions": "node scripts/export_private_sessions.js",
    "set-contact": "node scripts/set_contact.js",
    "check-contact": "node scripts/set_contact.js --check"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.63.0",
    "@supabase/supabase-js": "2.39.0"
  }
}
